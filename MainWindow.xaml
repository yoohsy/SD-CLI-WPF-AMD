<Window x:Class="CdCliWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:CdCliWpf.Controls"
        Title="SD CLI · Local Generator"
        Width="1280"
        Height="800"
        MinWidth="1100"
        MinHeight="700"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="3" Fill="{DynamicResource AmbientGlow}" IsHitTestVisible="False" />

        <Grid Grid.Row="0"
              Background="{DynamicResource TopBarBg}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Border Width="34"
                    Height="34"
                    CornerRadius="9"
                    Background="{DynamicResource AccentGradient}"
                    Margin="18,0,0,0"
                    HorizontalAlignment="Left">
                <Path Data="M12,2 L22,7 L22,17 L12,22 L2,17 L2,7 Z M12,7 L7,9.5 L7,14.5 L12,17 L17,14.5 L17,9.5 Z"
                      Fill="White"
                      Stretch="Uniform"
                      Width="18"
                      Height="18" />
            </Border>

            <StackPanel Margin="62,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="SD CLI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="LOCAL IMAGE GENERATOR  ·  STABLE-DIFFUSION.CPP / AMD VULKAN"
                           FontSize="9"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                <Button Style="{StaticResource IconButtonStyle}" Click="Minimize_Click" ToolTip="Свернуть"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M2,9 L18,9 L18,11 L2,11 Z" Fill="{DynamicResource SecondaryTextBrush}" Stretch="Uniform" Width="13" Height="13" />
                </Button>
                <Button x:Name="MaxButton" Style="{StaticResource IconButtonStyle}" Click="Maximize_Click" ToolTip="Развернуть"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path x:Name="MaxIcon" Data="M3,3 L17,3 L17,17 L3,17 Z M5,5 L5,15 L15,15 L15,5 Z"
                          Fill="{DynamicResource SecondaryTextBrush}" Stretch="Uniform" Width="13" Height="13" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="Close_Click" ToolTip="Закрыть"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M3,3 L5,3 L10,8 L15,3 L17,3 L17,5 L12,10 L17,15 L17,17 L15,17 L10,12 L5,17 L3,17 L3,15 L8,10 L3,5 Z"
                          Fill="{DynamicResource SecondaryTextBrush}" Stretch="Uniform" Width="13" Height="13" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="18,12,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <Border Style="{StaticResource CardStyle}"
                            AllowDrop="True"
                            PreviewDragOver="DropTarget_PreviewDragOver"
                            PreviewDrop="ModelDrop_PreviewDrop">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="МОДЕЛЬ" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                <Button Content="Выбрать"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding BrowseModelCommand}"
                                        FontSize="11"
                                        Padding="9,5"
                                        HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Text="{Binding ModelPath}"
                                       Style="{StaticResource ValueTextStyle}"
                                       Margin="0,10,0,0"
                                       ToolTip="{Binding ModelPath}"
                                       Visibility="{Binding ModelPath, Converter={StaticResource NotEmptyToVisibility}}" />
                            <TextBlock Text="Модель не выбрана"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource AccentLightBrush}"
                                       FontSize="12"
                                       Visibility="{Binding ModelPath, Converter={StaticResource EmptyToVisibility}}" />
                            <TextBlock Text=".gguf / .safetensors · можно перетащить файл"
                                       Style="{StaticResource HintTextStyle}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,12,0,0"
                            AllowDrop="True"
                            PreviewDragOver="DropTarget_PreviewDragOver"
                            PreviewDrop="LoraDrop_PreviewDrop">
                        <StackPanel>
                            <TextBlock Text="LORA" Style="{StaticResource SectionTitleStyle}" />
                            <CheckBox Content="Использовать LoRA"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding UseLora}"
                                      Margin="0,11,0,0" />
                            <StackPanel Margin="0,10,0,0" IsEnabled="{Binding UseLora}">
                                <Grid>
                                    <Button Content="Выбрать"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding BrowseLoraCommand}"
                                            FontSize="11"
                                            Padding="9,5"
                                            HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding LoraPath}"
                                               Style="{StaticResource ValueTextStyle}"
                                               Width="145"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding LoraPath}"
                                               Visibility="{Binding LoraPath, Converter={StaticResource NotEmptyToVisibility}}" />
                                    <TextBlock Text="Файл не выбран"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding LoraPath, Converter={StaticResource EmptyToVisibility}}" />
                                </Grid>
                                <TextBlock Text="Вес LoRA" Style="{StaticResource HintTextStyle}" Margin="0,10,0,4" />
                                <controls:NumericStepper Value="{Binding LoraWeight}"
                                                         Minimum="0.05"
                                                         Maximum="1.5"
                                                         Step="0.05"
                                                         Decimals="2"
                                                         Height="30" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,12,0,0"
                            AllowDrop="True"
                            PreviewDragOver="DropTarget_PreviewDragOver"
                            PreviewDrop="OutputDrop_PreviewDrop">
                        <StackPanel>
                            <TextBlock Text="ПАПКА СОХРАНЕНИЯ" Style="{StaticResource SectionTitleStyle}" />
                            <Grid Margin="0,10,0,0">
                                <Button Content="Выбрать"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding BrowseOutputCommand}"
                                        FontSize="11"
                                        Padding="9,5"
                                        HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding OutputDirectory}"
                                           Style="{StaticResource ValueTextStyle}"
                                           Width="145"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding OutputDirectory}"
                                           Visibility="{Binding OutputDirectory, Converter={StaticResource NotEmptyToVisibility}}" />
                                <TextBlock Text="Папка не выбрана"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding OutputDirectory, Converter={StaticResource EmptyToVisibility}}" />
                            </Grid>
                            <Button Content="Открыть папку"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding OpenOutputCommand}"
                                    FontSize="11"
                                    Padding="9,5"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" Margin="14,0,14,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="ПОЗИТИВНЫЙ ПРОМПТ" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="основное описание" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Красивый пейзаж, мягкий свет, высокая детализация..."
                                     Style="{StaticResource InputTextBoxStyle}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="72"
                                     Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="НЕГАТИВНЫЙ ПРОМПТ" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="что исключить" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBox Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="blur, low quality, artifacts..."
                                     Style="{StaticResource InputTextBoxStyle}"
                                     TextWrapping="Wrap"
                                     Height="48"
                                     Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="ПОЗА / ДЕТАЛИ" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="добавляется к промпту" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBox Text="{Binding Pose, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="standing, full body, dynamic pose..."
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Height="40"
                                     Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="ПАРАМЕТРЫ" Style="{StaticResource SectionTitleStyle}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Шаги" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="CFG" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Ширина" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                                <controls:NumericStepper Grid.Row="1" Grid.Column="0" Value="{Binding Steps}" Minimum="1" Maximum="50" Step="1" Margin="0,0,10,0" />
                                <controls:NumericStepper Grid.Row="1" Grid.Column="1" Value="{Binding Cfg}" Minimum="1" Maximum="20" Step="0.5" Decimals="1" Margin="0,0,10,0" />
                                <controls:NumericStepper Grid.Row="1" Grid.Column="2" Value="{Binding Width}" Minimum="512" Maximum="2048" Step="64" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Высота" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Сид" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Сэмплинг" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                                <controls:NumericStepper Grid.Row="4" Grid.Column="0" Value="{Binding Height}" Minimum="512" Maximum="2048" Step="64" Margin="0,0,10,0" />
                                <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,10,0">
                                    <controls:NumericStepper Value="{Binding Seed}"
                                                             Minimum="1"
                                                             Maximum="1000000000"
                                                             Step="1"
                                                             IsEnabled="{Binding RandomSeed, Converter={StaticResource InverseBool}}" />
                                    <TextBlock Text="-1"
                                               Foreground="{DynamicResource AccentLightBrush}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding RandomSeed, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <Border Grid.Row="4" Grid.Column="2"
                                        Background="{DynamicResource FieldBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock Text="DPM++ 2M"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <CheckBox Grid.Row="5" Grid.Column="1"
                                          Content="Случайный"
                                          Style="{StaticResource SmallCheckStyle}"
                                          IsChecked="{Binding RandomSeed}"
                                          Margin="0,5,10,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding GenerateCommand}"
                                Height="58"
                                FontSize="14">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M13,2 L3,14 L10,14 L9,22 L19,10 L12,10 Z"
                                      Fill="White"
                                      Stretch="Uniform"
                                      Width="17"
                                      Height="17" />
                                <TextBlock Text="СГЕНЕРИРОВАТЬ" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Style="{StaticResource GhostButtonStyle}"
                                Content="СТОП"
                                Command="{Binding CancelCommand}"
                                IsEnabled="{Binding IsGenerating}"
                                Height="58"
                                Margin="10,0,0,0" />
                    </Grid>

                    <Expander Header="ЛОГ ВЫПОЛНЕНИЯ"
                              Foreground="{DynamicResource SecondaryTextBrush}"
                              Background="Transparent"
                              BorderBrush="{DynamicResource LineBrush}"
                              FontSize="11"
                              FontWeight="SemiBold"
                              Margin="0,10,0,0">
                        <ListBox ItemsSource="{Binding LogLines}"
                                 Height="120"
                                 Margin="0,6,0,0"
                                 Background="{DynamicResource FieldBrush}"
                                 BorderBrush="{DynamicResource LineBrush}"
                                 BorderThickness="1"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 FontSize="11" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="252" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="РЕЗУЛЬТАТ" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="предпросмотр" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Grid.Row="1"
                                Margin="0,10,0,0"
                                Background="{DynamicResource DarkPanelBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding PreviewImage}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Path Data="M21,19 V5 C21,3.9 20.1,3 19,3 H5 C3.9,3 3,3.9 3,5 V19 C3,20.1 3.9,21 5,21 H19 C20.1,21 21,20.1 21,19 Z M8.5,13.5 L11,16.5 L14.5,12 L19,18 H5 L8.5,13.5 Z M8,9 A1.5,1.5 0 1,1 11,9 A1.5,1.5 0 1,1 8,9 Z"
                                          Fill="{DynamicResource MutedBrush}"
                                          Stretch="Uniform"
                                          Width="46"
                                          Height="46"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="Здесь появится результат"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}">
                                    <Ellipse Width="42"
                                             Height="42"
                                             Stroke="{DynamicResource AccentBrush}"
                                             StrokeThickness="3"
                                             StrokeDashArray="4 3"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0"
                                                                         To="360"
                                                                         Duration="0:0:1.1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <TextBlock Text="Генерация..."
                                               Foreground="{DynamicResource AccentLightBrush}"
                                               FontSize="12"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="ИСТОРИЯ" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="двойной клик — открыть" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Right" />
                        </Grid>
                        <ListBox x:Name="HistoryList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding History}"
                                 Style="{StaticResource HistoryListStyle}"
                                 Margin="0,10,0,0"
                                 MouseDoubleClick="HistoryList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="26" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="52"
                                                Height="42"
                                                CornerRadius="6"
                                                Background="{DynamicResource FieldBrush}"
                                                ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource IconButtonStyle}"
                                                Width="26"
                                                Height="26"
                                                Command="{Binding DataContext.RemoveHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Убрать из истории">
                                            <Path Data="M3,3 L5,3 L10,8 L15,3 L17,3 L17,5 L12,10 L17,15 L17,17 L15,17 L10,12 L5,17 L3,17 L3,15 L8,10 L3,5 Z"
                                                  Fill="{DynamicResource MutedBrush}"
                                                  Stretch="Uniform"
                                                  Width="9"
                                                  Height="9" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource TopBarBg}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="11"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding EngineText}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding LastLog}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           MaxWidth="420"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
