                                    <TextBlock Text="последний режим" Foreground="{DynamicResource AccentLightBrush}"
                                               FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Button Content="ПРОДОЛЖИТЬ С ПОСЛЕДНЕГО РЕЖИМА"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding ContinueCommand}"
                            IsDefault="True"
                            Width="300"
                            Height="42"
                            Margin="0,24,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource TopBarBg}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="11"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding EngineText}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding LastLog}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           MaxWidth="420"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
