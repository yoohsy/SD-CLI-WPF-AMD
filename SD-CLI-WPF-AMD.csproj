<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>SD-CLI-WPF-AMD</AssemblyTitle>
    <Product>SD-CLI-WPF-AMD</Product>
    <RootNamespace>CdCliWpf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Update="engine\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
